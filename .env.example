# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. On GitHub, set these as Actions secrets instead.

# Entire contents of the service-account key file, on ONE line, e.g.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"lead-bot@....iam.gserviceaccount.com",...}
GOOGLE_SERVICE_ACCOUNT_JSON=

# From the Sheet URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# Optional. Google Cloud > APIs & Services > Credentials > API key (YouTube Data API v3).
# Leave empty to call the YouTube API with the service account instead.
YOUTUBE_API_KEY=

# Optional web search, used only to find creators' Instagram profiles and read the public
# bio shown in search results. https://app.tavily.com (primary), https://serpapi.com (fallback)
TAVILY_API_KEY=
SERPAPI_KEY=

# Dashboard login, used only by `python -m pipeline.export_site` to encrypt the data
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Optional
# LOG_LEVEL=DEBUG
